{
    "name": "jestays/laravel-centrifugo",
    "description": "Laravel broadcasting driver for Centrifugo 6+ with multi-application channel and user scoping.",
    "keywords": [
        "laravel-broadcaster",
        "broadcaster",
        "laravel",
        "centrifugo",
        "web socket",
        "web-socket",
        "websocket",
        "socket",
        "real time"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "jestays",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/jestays/laravel-centrifugo",
    "support": {
        "issues": "https://github.com/jestays/laravel-centrifugo/issues",
        "source": "https://github.com/jestays/laravel-centrifugo"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "centrifugal/phpcent": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Jestays\\Centrifugo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jestays\\Centrifugo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jestays\\Centrifugo\\CentrifugoServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "lint:fix": "pint"
    }
}
